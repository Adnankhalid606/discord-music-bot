# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_bot_token_here

# Discord Application / Client ID
CLIENT_ID=your_client_id_here

# Development Discord Server / Guild ID
GUILD_ID=your_development_guild_id_here

# Command Prefix for text-based commands
PREFIX=!

# Optional path to yt-dlp executable (defaults to 'yt-dlp' in system PATH)
# Examples:
# YT_DLP_PATH=yt-dlp
# YT_DLP_PATH=C:\Program Files\yt-dlp\yt-dlp.exe
YT_DLP_PATH=yt-dlp

# Diagnostic Command Execution Timing Logs (defaults to true; set to false to disable)
COMMAND_TIMING_LOGS=true

